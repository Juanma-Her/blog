{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Post front matter (JSON contracts 3.1)",
  "type": "object",
  "required": [
    "title",
    "date",
    "description",
    "tags",
    "ref"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 110
    },
    "date": {
      "$ref": "#/$defs/date"
    },
    "description": {
      "type": "string",
      "minLength": 40,
      "maxLength": 200
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "ref": {
      "$ref": "#/$defs/slug"
    },
    "lang": {
      "enum": [
        "en",
        "es"
      ]
    },
    "updated": {
      "$ref": "#/$defs/date"
    },
    "hero_code": {
      "type": "object",
      "required": [
        "lang",
        "code"
      ],
      "additionalProperties": false,
      "properties": {
        "lang": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "comments": {
      "type": "boolean"
    },
    "image": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9+]+(-[a-z0-9+]+)*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}( \\d{2}:\\d{2}(:\\d{2})? [+-]\\d{4})?$"
    }
  }
}
