{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "_data/i18n/<lang>.json (JSON contracts 4.4)",
  "$ref": "#/$defs/group",
  "$defs": {
    "group": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9_]+$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "$ref": "#/$defs/group"
          }
        ]
      }
    }
  }
}
